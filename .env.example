# AlertOps Configuration
# Copy this file to .env and fill in your values.

# LLM Provider (for AI diagnosis and alert generation)
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Grafana API Key (optional, for dashboard listing)
GRAFANA_API_KEY=

# Authentication
# Set to false to disable authentication entirely (open access, for local dev)
AUTH_ENABLED=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=Admin
AUTH_JWT_SECRET=change-this-to-a-random-string
AUTH_JWT_EXPIRATION_HOURS=3

# Alert history cleanup
ALERT_HISTORY_RETENTION_DAYS=90
ALERT_HISTORY_CLEANUP_ACTION=delete
